{% extends 'base.html.twig' %}

{% block title %}Nouvel utilisateur{% endblock %}

{% block body %}
    <div class="dashboard">
        {% include 'header/header.html.twig' %}
        <div class="container-user mt-4">
            <div class="row justify-content-center">
                <div class="col-md-8 d-flex flex-column align-items-center">

                    {# ========== TITRE ========== #}
                    <div class="page-title">
                        <h1 class="text-center mb-4">Nouvel utilisateur</h1>
                        <div class="subtitle">Créer un nouveau compte</div>
                    </div>

                    {# ========== FORMULAIRE STYLÉ ========== #}
                    <div class="user-form">
                        {{ include('user/_form.html.twig', {'button_label': 'Créer'}) }}
                    </div>

                    {# ========== BOUTON RETOUR ========== #}
                    <div class="action-buttons">
                        <a href="{{ path('app_user_index') }}" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left"></i> Retour à la liste
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
{% endblock %}