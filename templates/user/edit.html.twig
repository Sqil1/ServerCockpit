{% extends 'base.html.twig' %}

{% block title %}Modifier l'utilisateur{% endblock %}

{% block body %}
    <div class="dashboard">
        {% include 'header/header.html.twig' %}
        <div class="container-user mt-4">
            <div class="row justify-content-center">
                <div class="col-md-8 d-flex flex-column align-items-center">

                    <div class="page-title">
                        <h1 class="text-center mb-4">Modifier l'utilisateur</h1>
                        <div class="subtitle">{{ user.firstName }} {{ user.lastName }}</div>
                    </div>

                    <div class="user-form">
                        {{ include('user/_form.html.twig', {'button_label': 'Enregistrer'}) }}
                    </div>

                    <div class="action-buttons">
                        <a href="{{ path('app_user_index') }}" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left"></i> Retour à la liste
                        </a>
                        <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-outline-info">
                            <i class="fas fa-eye"></i> Voir le détail
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
{% endblock %}