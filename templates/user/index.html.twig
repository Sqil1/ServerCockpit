{% extends 'base.html.twig' %}

{% block title %}User index{% endblock %}

{% block body %}
    <div class="dashboard">
        {% include 'header/header.html.twig' %}
        <div class="container-user mt-4">
            <div class="row justify-content-center">
                <div class="col-md-12">
                    <div class="page-title">
                        <h1 class="text-center mb-4">Gestion des utilisateurs</h1>
                        <div class="subtitle">Administrer les comptes et permissions</div>
                    </div>
                    <div class="search-filters">
                        <form method="GET" action="{{ path('app_user_index') }}">
                            <div class="filters-row">
                                <input type="text"
                                       class="form-control filter-search"
                                       name="search"
                                       value="{{ search }}"
                                       placeholder="Rechercher...">

                                <select class="form-control filter-select" name="role">
                                    <option value="">Tous les rôles</option>
                                    <option value="ROLE_ADMIN" {{ role == 'ROLE_ADMIN' ? 'selected' : '' }}>Admin</option>
                                    <option value="ROLE_USER" {{ role == 'ROLE_USER' ? 'selected' : '' }}>Utilisateur</option>
                                </select>

                                <select class="form-control filter-select" name="isActive">
                                    <option value="">Tous les statuts</option>
                                    <option value="Y" {{ isActive == 'Y' ? 'selected' : '' }}>Actif</option>
                                    <option value="N" {{ isActive == 'N' ? 'selected' : '' }}>Inactif</option>
                                </select>

                                <button type="submit" class="btn btn-primary filter-btn">
                                    <i class="fas fa-search"></i>
                                </button>

                                <a href="{{ path('app_user_index') }}" class="btn btn-outline-secondary filter-btn">
                                    <i class="fas fa-times"></i>
                                </a>
                            </div>
                        </form>
                    </div>
                    <div class="user-table">
                        <table class="table">
                            <thead class="">
                            <tr>
                                <th>Email</th>
                                <th>User</th>
                                <th>Roles</th>
                                <th>Prénom</th>
                                <th>Nom</th>
                                <th>Actif</th>
                                <th>Date de création</th>
                                <th>Date de mise à jour</th>
                                <th>LoginAttempts</th>
                                <th>Vérouillé</th>
                                <th>Dernière connexion</th>
                                <th>actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for user in users %}
                                <tr>
                                    <td><span class="user-value">{{ user.email }}</span></td>
                                    <td><span class="user-value">{{ user.username }}</span></td>
                                    <td>
                                        {% for role in user.roles %}
                                            <span class="role-badge">{{ role }}</span>
                                        {% endfor %}
                                    </td>
                                    <td><span class="user-value">{{ user.firstName }}</span></td>
                                    <td><span class="user-value">{{ user.lastName }}</span></td>
                                    <td>
                                <span class="status-badge {{ user.isActive == 'Y' ? 'active' : 'inactive' }}">
                                    {{ user.isActive == 'Y' ? 'Actif' : 'Inactif' }}
                                </span>
                                    </td>
                                    <td>
                                        <span class="user-value">{{ user.datCre ? user.datCre|date('d/m/Y H:i:s') : '' }}</span>
                                    </td>
                                    <td>
                                        <span class="user-value">{{ user.datUpd ? user.datUpd|date('d/m/Y H:i:s') : '' }}</span>
                                    </td>
                                    <td><span class="user-value">{{ user.loginAttempts }}</span></td>
                                    <td><span class="status-badge {{ user.isLocked == 'Y' ? 'inactive' : 'active' }}">
                                    {{ user.isLocked == 'Y' ? 'Oui' : 'Non' }}
                                </span></td>
                                    <td>
                                        <span class="user-value">{{ user.lastLogin ? user.lastLogin|date('d/m/Y H:i:s') : '' }}</span>
                                    </td>
                                    <td>
                                        <a href="{{ path('app_user_show', {'id': user.id}) }}"
                                           class="btn btn-sm btn-outline-info">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="{{ path('app_user_edit', {'id': user.id}) }}"
                                           class="btn btn-sm btn-outline-warning">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="12">Aucun utilisateur trouvé</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="pagination-wrapper">
                        <div class="pagination-info">
                            <i class="fas fa-users"></i>
                            <span>{{ users.getTotalItemCount }} utilisateur(s) trouvé(s)</span>
                        </div>
                        <div class="pagination-nav">
                            {{ knp_pagination_render(users) }}
                        </div>
                    </div>
                </div>
            </div>
            <div class="text-center mb-3">
                <a href="{{ path('app_user_new') }}" class="btn btn-primary btn-lg">
                    <i class="fas fa-plus"></i> Nouvel utilisateur
                </a>
            </div>
        </div>
    </div>
{% endblock %}