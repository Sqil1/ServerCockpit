{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="login-container">
        <!-- Logo -->
        <div class="login-logo">
            <img src="{{ asset('build/logo.svg') }}" alt="ServerCockpit" width="80">
        </div>

        <!-- Titre -->
        <h1>Connexion</h1>
        <p class="subtitle">Accédez à votre espace personnel</p>

        <form method="post" id="login-form">
            <!-- Messages d'erreur -->
            {% if error %}
                <div class="alert alert-danger" id="error-alert">
                    <i class="fas fa-exclamation-triangle"></i>
                    <div class="error-content">
                        <strong>Erreur de connexion</strong>
                        <p>{{ error_message ?? error.messageKey }}</p>
                    </div>
                    <button type="button" class="close-alert" onclick="closeAlert()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            {% endif %}

            <!-- Messages flash (succès, info) -->
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type }}">
                        <i class="fas fa-{{ type == 'success' ? 'check-circle' : 'info-circle' }}"></i>
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            <!-- Utilisateur déjà connecté -->
            {% if app.user %}
                <div class="user-info">
                    <p>
                        <i class="fas fa-user"></i>
                        Vous êtes connecté en tant que {{ app.user.userIdentifier }},
                        <a href="{{ path('app_logout') }}">Se déconnecter</a>
                    </p>
                </div>
            {% endif %}

            <!-- Champ Email -->
            <div class="form-group">
                <label for="username">
                    <i class="fas fa-envelope"></i>
                    Adresse email
                </label>
                <input type="email"
                       value="{{ last_username }}"
                       name="_username"
                       id="username"
                       class="form-control {{ error ? 'error' : '' }}"
                       placeholder="votre@email.com"
                       autocomplete="email"
                       required
                       autofocus>
                <span class="error-message" id="username-error"></span>
            </div>

            <!-- Champ Mot de passe -->
            <div class="form-group">
                <label for="password">
                    <i class="fas fa-lock"></i>
                    Mot de passe
                </label>
                <div class="password-input">
                    <input type="password"
                           name="_password"
                           id="password"
                           class="form-control {{ error ? 'error' : '' }}"
                           placeholder="••••••••"
                           autocomplete="current-password"
                           required>
                    <button type="button" class="toggle-password" onclick="togglePassword()">
                        <i class="fas fa-eye" id="password-toggle-icon"></i>
                    </button>
                </div>
                <span class="error-message" id="password-error"></span>
            </div>

            <!-- Token CSRF -->
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <!-- Se souvenir de moi -->
            <div class="remember-me">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                <label for="_remember_me">Se souvenir de moi</label>
            </div>

            <!-- Bouton de connexion -->
            <button class="btn btn-primary" type="submit" id="login-btn">
                <i class="fas fa-sign-in-alt"></i>
                <span>Se connecter</span>
            </button>

            <!-- Indicateur de chargement -->
            <div class="loading-indicator" id="loading" style="display: none;">
                <i class="fas fa-spinner fa-spin"></i>
                Connexion en cours...
            </div>
        </form>

    </div>

{% endblock %}