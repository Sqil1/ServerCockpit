{% extends 'base.html.twig' %}

{% block title %}Dashboard - ServerCockpit{% endblock %}

{% block body %}
    <div class="dashboard">
        <!-- Header avec navigation -->
        {% include 'header/header.html.twig' %}
        <!-- Contenu principal -->
        <main class="dashboard-main">
            <div class="container">
                <!-- Titre de la page -->
                <div class="page-header">
                    <h1>
                        <i class="fas fa-tachometer-alt"></i>
                        Dashboard
                    </h1>
                    <p>Vue d'ensemble du système {{ system_info.hostname ?? 'serveur' }}</p>
                </div>

                <!-- Messages d'erreur -->
                <div id="error-messages"></div>

                <!-- Contrôles du monitoring -->
                <div class="monitoring-controls">
                    <button id="toggle-monitoring" class="btn btn-warning">
                        <i class="fas fa-pause"></i> Pause
                    </button>
                    <button id="manual-refresh" class="btn btn-primary">
                        <i class="fas fa-sync-alt"></i> Actualiser
                    </button>
                    <select id="refresh-interval" class="form-select">
                        <option value="3">3 secondes</option>
                        <option value="5">5 secondes</option>
                        <option value="10">10 secondes</option>
                        <option value="30">30 secondes</option>
                    </select>
                    <span class="last-update">
                        Dernière mise à jour: <span id="last-refresh">--:--:--</span>
                    </span>
                </div>

                <!-- Widgets de monitoring -->
                <div class="monitoring-widgets">

                    <!-- Widget CPU -->
                    <div id="cpu-widget" class="widget">
                        <div class="widget-header">
                            <h3><i class="fas fa-microchip"></i> Processeur</h3>
                        </div>
                        <div class="widget-content">
                            <div class="cpu-cores">Chargement...</div>
                            <div class="cpu-load"></div>
                            <div class="cpu-global"></div>
                            <div class="cpu-cores-detail"></div>
                        </div>
                    </div>

                    <!-- Widget Mémoire -->
                    <div id="memory-widget" class="widget">
                        <div class="widget-header">
                            <h3><i class="fas fa-memory"></i> Mémoire RAM</h3>
                        </div>
                        <div class="widget-content">
                            <div class="progress-container">
                                <div class="progress">
                                    <div class="progress-bar" role="progressbar" style="width: 0%"></div>
                                </div>
                                <div class="progress-label">
                                    <span class="memory-percentage">0%</span>
                                </div>
                            </div>
                            <div class="memory-usage">
                                <div>Chargement...</div>
                            </div>
                        </div>
                    </div>

                    <!-- Widget Disque -->
                    <div id="disk-widget" class="widget">
                        <div class="widget-header">
                            <h3><i class="fas fa-hdd"></i> Espace disque</h3>
                        </div>
                        <div class="widget-content">
                            <div class="progress-container">
                                <div class="progress">
                                    <div class="progress-bar" role="progressbar" style="width: 0%"></div>
                                </div>
                                <div class="progress-label">
                                    <span class="disk-percentage">0%</span>
                                </div>
                            </div>
                            <div class="disk-usage">
                                <div>Chargement...</div>
                            </div>
                        </div>
                    </div>

                    <!-- Widget Réseau -->
                    <div id="network-widget" class="widget">
                        <div class="widget-header">
                            <h3><i class="fas fa-network-wired"></i> Réseau</h3>
                        </div>
                        <div class="widget-content">
                            <div class="network-interfaces">
                                <div>Chargement...</div>
                            </div>
                        </div>
                    </div>

                    <!-- Widget Informations système -->
                    <div id="system-widget" class="widget">
                        <div class="widget-header">
                            <h3><i class="fas fa-info-circle"></i> Système</h3>
                        </div>
                        <div class="widget-content">
                            <div id="system-info">
                                {% if system_info %}
                                    <div><strong>Serveur:</strong> {{ system_info.hostname }}</div>
                                    <div><strong>OS:</strong> {{ system_info.os }} ({{ system_info.architecture }})</div>
                                    <div><strong>PHP:</strong> {{ system_info.php_version }}</div>
                                    <div><strong>Uptime:</strong> {{ system_info.uptime }}</div>
                                {% else %}
                                    <div>Chargement des informations système...</div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <!-- Widget Load Average -->
                    <div id="load-widget" class="widget">
                        <div class="widget-header">
                            <h3><i class="fas fa-chart-area"></i> Charge système</h3>
                        </div>
                        <div class="widget-content">
                            <div class="load-averages">
                                <div class="load-item">
                                    <span>1 min:</span>
                                    <span class="load-1min">0.00</span>
                                </div>
                                <div class="load-item">
                                    <span>5 min:</span>
                                    <span class="load-5min">0.00</span>
                                </div>
                                <div class="load-item">
                                    <span>15 min:</span>
                                    <span class="load-15min">0.00</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
{% endblock %}