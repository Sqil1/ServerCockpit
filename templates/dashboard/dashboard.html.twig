{% extends 'base.html.twig' %}

{% block title %}Dashboard - ServerCockpit{% endblock %}

{% block body %}
    <div class="dashboard">
        <!-- Header avec navigation -->
        <header class="dashboard-header">
            <div class="container">
                <div class="header-content">
                    <!-- Logo -->
                    <div class="logo">
                        <img src="{{ asset('build/logo.svg') }}" alt="ServerCockpit" width="40">
                        <span>ServerCockpit</span>
                    </div>

                    <!-- Navigation -->
                    <nav class="nav-menu">
                        <a href="#" class="nav-link active">
                            <i class="fas fa-tachometer-alt"></i>
                            Dashboard
                        </a>
                        <a href="#" class="nav-link">
                            <i class="fas fa-server"></i>
                            Serveurs
                        </a>
                        <a href="#" class="nav-link">
                            <i class="fas fa-chart-line"></i>
                            Monitoring
                        </a>
                        <a href="#" class="nav-link">
                            <i class="fas fa-cog"></i>
                            Paramètres
                        </a>
                    </nav>

                    <!-- User menu -->
                    <div class="user-menu">
                        <div class="user-profile">
                            <i class="fas fa-user-circle"></i>
                            <span>{{ app.user.userIdentifier ?? 'Utilisateur' }}</span>
                        </div>
                        <a href="{{ path('app_logout') }}" class="btn btn-logout">
                            <i class="fas fa-sign-out-alt"></i>
                            Déconnexion
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <!-- Contenu principal -->
        <main class="dashboard-main">
            <div class="container">
                <!-- Titre de la page -->
                <div class="page-header">
                    <h1>
                        <i class="fas fa-tachometer-alt"></i>
                        Dashboard
                    </h1>
                    <p>Vue d'ensemble</p>
                </div>

                <!-- Cartes de statistiques -->
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon">
                            <i class="fas fa-microchip"></i>
                        </div>
                        <div class="stat-content">
                            <h3>45%</h3>
                            <p>Processeur</p>
                        </div>
                        <div class="stat-trend up">
                            <i class="fas fa-arrow-up"></i>
                            +5%
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon warning">
                            <i class="fas fa-memory"></i>
                        </div>
                        <div class="stat-content">
                            <h3>78%</h3>
                            <p>Mémoire RAM</p>
                        </div>
                        <div class="stat-trend up">
                            <i class="fas fa-arrow-up"></i>
                            +12%
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon success">
                            <i class="fas fa-hdd"></i>
                        </div>
                        <div class="stat-content">
                            <h3>234 GB</h3>
                            <p>Espace disque</p>
                        </div>
                        <div class="stat-trend down">
                            <i class="fas fa-arrow-down"></i>
                            -2 GB
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon">
                            <i class="fas fa-network-wired"></i>
                        </div>
                        <div class="stat-content">
                            <h3>125 MB/s</h3>
                            <p>Réseau</p>
                        </div>
                        <div class="stat-trend up">
                            <i class="fas fa-arrow-up"></i>
                            +15 MB/s
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
{% endblock %}